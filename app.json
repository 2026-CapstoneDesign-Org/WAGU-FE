{
  "expo": {
    "name": "WAGU",
    "slug": "WAGU",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/WAGU.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/WAGUsplash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.wagu.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "프로필 사진을 촬영하기 위해 카메라 접근 권한이 필요합니다.",
        "NSPhotoLibraryUsageDescription": "프로필 사진을 변경하기 위해 사진 보관함 접근 권한이 필요합니다."
      }
    },
    "android": {
      "package": "com.wagu.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/WAGU.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "@mj-studio/react-native-naver-map",
        {
          "client_id": "vimbg0mo44"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "https://repository.map.naver.com/archive/maven"
            ]
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필 사진을 변경하기 위해 사진 보관함 접근 권한이 필요합니다.",
          "cameraPermission": "프로필 사진을 촬영하기 위해 카메라 접근 권한이 필요합니다."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
